# Optional. Leave these out entirely and PROOF runs in local mode,
# storing sessions in this browser only.
#
# To sync across devices, create a free project at supabase.com,
# then copy these two values from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
